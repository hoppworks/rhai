+#!/usr/bin/env python3
+"""Orchestrate one finite interruption control through the scoped custodian."""
+import argparse
+import importlib.util
+import json
+import math
+import os
+import signal
+import socket
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+sys.dont_write_bytecode = True
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[1]
+ADAPTER = HERE / 'run-macos-process-overhead-scoped.py'
+CONTROL = HERE / 'macos-process-overhead-control.py'
+EVIDENCE = REPO / '.scratch/all-tickets/macos-process-overhead-evidence'
+CASES = {'setup', 'build', 'managed', 'deadline'}
+OUTER_LIMIT = 600.0
+ADAPTER_LIMIT = 585.0
+WRAPPER_RESERVE = 15.0
+INTERRUPT_SIGNALS = {signal.SIGINT, signal.SIGTERM}
+BOOTSTRAP = (
+    'import os,signal,sys; '
+    'signal.pthread_sigmask(signal.SIG_UNBLOCK,{signal.SIGINT,signal.SIGTERM}); '
+    'os.execv(sys.argv[0],sys.argv)'
+)
+
+CONTROL_SPEC = importlib.util.spec_from_file_location('overhead_finite_control_client', CONTROL)
+control_client = importlib.util.module_from_spec(CONTROL_SPEC)
+CONTROL_SPEC.loader.exec_module(control_client)
+
+
+class ControlCancelled(BaseException):
+    pass
+
+
+def validate_case(case):
+    if type(case) is not str or case not in CASES:
+        raise ValueError('exactly one of setup, build, managed or deadline is required')
+    return case
+
+
+def expected_result(case):
+    validate_case(case)
+    return {
+        'setup': ('client-interrupted', -signal.SIGTERM),
+        'build': ('client-interrupted', -signal.SIGKILL),
+        'managed': ('managed-host-interrupted', -signal.SIGKILL),
+        'deadline': ('deadline-stop-observed', -signal.SIGKILL),
+    }[case]
+
+
+def adapter_argv(python, adapter, case, timeout):
+    validate_case(case)
+    if (type(timeout) not in (int, float) or not math.isfinite(timeout)
+            or timeout <= 0 or timeout > ADAPTER_LIMIT):
+        raise ValueError('adapter timeout must be positive and at most 585 seconds')
+    return [str(python), str(adapter), '--timeout', format(float(timeout), '.9g'),
+            '--control-case', case]
+
+
+def registered_exec_argv(argv, python=None):
+    """Exec one exact target with signals unblocked after its Popen slot exists."""
+    if type(argv) not in (list, tuple) or not argv or any(type(item) is not str for item in argv):
+        raise ValueError('registered child argv must be a nonempty string vector')
+    return [str(python or sys.executable), '-c', BOOTSTRAP, *argv]
+
+
+def parse_socket_announcement(text, scope, case):
+    validate_case(case)
+    if type(text) is not str:
+        raise ValueError('custodian socket announcement is not text')
+    records = [line for line in text.splitlines()
+               if line.startswith('control_socket_path=')]
+    if len(records) != 1:
+        raise ValueError('custodian did not publish exactly one controller socket')
+    fields = records[0].split()
+    if len(fields) != 2 or not fields[0].startswith('control_socket_path=') \
+            or not fields[1].startswith('control_case='):
+        raise ValueError('custodian controller announcement is malformed')
+    path = Path(fields[0].split('=', 1)[1])
+    announced_case = fields[1].split('=', 1)[1]
+    runtime = Path(scope).resolve(strict=True) / 'runtime'
+    expected = runtime / 'controller.sock'
+    if (announced_case != case or not path.is_absolute() or path != expected
+            or path.parent != runtime or runtime.is_symlink()):
+        raise ValueError('custodian controller socket does not match the exact scope/case')
+    if path.is_symlink():
+        raise ValueError('custodian controller socket path is redirected')
+    return path
+
+
+def _closed_command_records(records, case, result):
+    if type(records) is not list or not records:
+        return False
+    matching = [record for record in records if type(record) is dict
+                and record.get('control_case') == case]
+    if len(matching) != 1:
+        return False
+    record = matching[0]
+    if not all(record.get(key) is True for key in
+               ('setup_complete', 'group_signal_issued', 'cleanup_complete')):
+        return False
+    if any(type(record.get(key)) is not int for key in ('gate_status', 'anchor_status')):
+        return False
+    event = record.get('control_readiness_event')
+    if (type(event) is not dict or event.get('event') != 'case-ready'
+            or event.get('case') != case or type(event.get('event_id')) is not str
+            or not event.get('event_id') or event.get('event_id') != result.get('event_id')):
+        return False
+    action, status = expected_result(case)
+    if case == 'deadline':
+        completion = record.get('control_completion_event')
+        return (record.get('control_stop_reason') == 'work-deadline-expired'
+                and record.get('control_action') is None
+                and type(completion) is dict
+                and completion.get('event') == 'deadline-expired'
+                and completion.get('case') == case
+                and completion.get('event_id') == result.get('event_id')
+                and completion.get('reason') == 'work-deadline-expired'
+                and completion.get('command_status') == status)
+    recorded = record.get('control_action')
+    return (type(recorded) is dict and recorded.get('action') == action
+            and recorded.get('case') == case
+            and recorded.get('event_id') == result.get('event_id')
+            and recorded.get('status') == result.get('status'))
+
+
+def validate_control_artifacts(case, adapter_status, controller_result, receipt,
+                               runtime_present):
+    try:
+        validate_case(case)
+        if adapter_status != 0 or runtime_present:
+            raise ValueError('custodian status/runtime cleanup is incomplete')
+        action, status = expected_result(case)
+        if (type(controller_result) is not dict
+                or set(controller_result) != {'case', 'event_id', 'action', 'status'}
+                or controller_result.get('case') != case
+                or type(controller_result.get('event_id')) is not str
+                or not controller_result.get('event_id')
+                or controller_result.get('action') != action
+                or type(controller_result.get('status')) is not int):
+            raise ValueError('controller result does not describe the selected action')
+        allowed = {status}
+        if case == 'setup':
+            allowed.add(-signal.SIGKILL)
+        if controller_result['status'] not in allowed:
+            raise ValueError('controller result status does not match the selected action')
+        if (type(receipt) is not dict or receipt.get('schema') != 1
+                or receipt.get('control_case') != case or receipt.get('complete') is not True):
+            raise ValueError('custodian receipt is absent, incomplete or for another case')
+        ledger = receipt.get('identity_ledger')
+        absence = receipt.get('candidate_absence')
+        if (type(ledger) is not dict or ledger.get('observed_identity_readback_complete') is not True
+                or type(absence) is not dict or absence.get('complete') is not True
+                or absence.get('candidates') != []
+                or type(receipt.get('groups_absent_observations')) is not int
+                or receipt['groups_absent_observations'] < 2):
+            raise ValueError('custodian identity/group/candidate readback is incomplete')
+        if not _closed_command_records(receipt.get('commands'), case, controller_result):
+            raise ValueError('custodian command/action receipt is incomplete or mismatched')
+        return True
+    except (AttributeError, KeyError, TypeError, ValueError) as exc:
+        raise ValueError(f'control package rejected: {exc}') from exc
+
+
+def _open_private_log(path):
+    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
+    flags |= getattr(os, 'O_NOFOLLOW', 0)
+    descriptor = os.open(path, flags, 0o600)
+    return os.fdopen(descriptor, 'w', encoding='utf-8')
+
+
+def _socket_announcement(log_path, scope, case):
+    if log_path.is_symlink() or not log_path.is_file():
+        return None
+    text = log_path.read_text(encoding='utf-8', errors='strict')
+    if 'control_socket_path=' not in text:
+        return None
+    try:
+        return parse_socket_announcement(text, scope, case)
+    except ValueError:
+        if text.endswith('\n'):
+            raise
+        return None
+
+
+def wait_for_socket(proc, log_path, scope, case, deadline, clock=time.monotonic,
+                    sleeper=time.sleep):
+    while clock() < deadline:
+        path = _socket_announcement(log_path, scope, case)
+        if path is not None:
+            return path
+        if proc.poll() is not None:
+            raise RuntimeError('custodian exited before publishing its controller socket')
+        sleeper(min(0.02, max(0, deadline - clock())))
+    raise TimeoutError('custodian controller socket was not published before its deadline')
+
+
+def _connect_controller(path, timeout):
+    conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    try:
+        conn.settimeout(min(2.0, timeout))
+        conn.connect(str(path))
+        conn.settimeout(None)
+        return conn
+    except BaseException:
+        conn.close()
+        raise
+
+
+def _spawn_registered(argv, stdout, env, popen_factory, signal_api=signal):
+    mask = getattr(signal_api, 'pthread_sigmask', None)
+    if not callable(mask):
+        raise RuntimeError('cannot register the custodian while safely blocking interruption')
+    prior = mask(signal_api.SIG_BLOCK, INTERRUPT_SIGNALS)
+    try:
+        proc = popen_factory(registered_exec_argv(argv), stdin=subprocess.DEVNULL,
+                             stdout=stdout, stderr=subprocess.STDOUT, env=env,
+                             close_fds=True)
+    finally:
+        mask(signal_api.SIG_SETMASK, prior)
+    return proc
+
+
+def _stop_exact_adapter(proc, deadline, clock=time.monotonic):
+    if proc.poll() is not None:
+        return proc.returncode
+    proc.send_signal(signal.SIGTERM)
+    remaining = max(0.0, deadline - clock())
+    try:
+        return proc.wait(timeout=min(15.0, remaining))
+    except subprocess.TimeoutExpired as exc:
+        raise RuntimeError(
+            f'custodian did not close within its bounded cancellation window; '
+            f'preserve runtime and owner pid={proc.pid}') from exc
+
+
+def run_control_case(case, scope, log_base, timeout=OUTER_LIMIT,
+                     popen_factory=subprocess.Popen, connect_fn=_connect_controller,
+                     protocol_fn=None, clock=time.monotonic, sleeper=time.sleep,
+                     manage_signals=True):
+    """Run one case, with the adapter as the only workload custodian."""
+    validate_case(case)
+    if type(timeout) not in (int, float) or not math.isfinite(timeout) \
+            or timeout <= 0 or timeout > OUTER_LIMIT:
+        raise ValueError('control package timeout must be positive and at most 600 seconds')
+    scope = Path(scope).absolute()
+    if scope.is_symlink() or not scope.is_dir() or scope.resolve(strict=True) != scope:
+        raise ValueError('control package scope must be an exact existing directory')
+    tmp = scope / 'tmp'
+    if tmp.is_symlink() or not tmp.is_dir() or tmp.resolve(strict=True) != tmp:
+        raise ValueError('control package requires its exact private scope tmp directory')
+    log_base = Path(log_base).absolute()
+    if (log_base.parent.resolve(strict=True) != EVIDENCE.resolve()
+            or log_base.is_symlink() or log_base.exists()):
+        raise ValueError('control evidence base must be a new path in the fixed evidence directory')
+    EVIDENCE.mkdir(parents=True, exist_ok=True)
+    if EVIDENCE.is_symlink():
+        raise ValueError('control evidence directory is redirected')
+    started = clock()
+    outer_deadline = started + float(timeout)
+    runtime = scope / 'runtime'
+    if runtime.exists() or runtime.is_symlink():
+        raise ValueError('control package runtime already exists')
+    adapter_log = Path(str(log_base) + '.adapter.log')
+    control_log = Path(str(log_base) + '.controller.json')
+    receipt_path = Path(str(log_base) + '.custody.json')
+    if any(path.exists() or path.is_symlink() for path in (adapter_log, control_log, receipt_path)):
+        raise ValueError('control evidence outputs already exist')
+    env = dict(os.environ)
+    env.update({'AGENT_BUILD_SCOPE': str(scope), 'TMPDIR': str(tmp), 'TMP': str(tmp),
+                'TEMP': str(tmp), 'RHAI_OVERHEAD_LOG_BASE': str(log_base)})
+    previous_handlers = {}
+    if manage_signals:
+        def interrupted(signum, _frame):
+            raise ControlCancelled(f'finite control received signal {signum}')
+        for signum in INTERRUPT_SIGNALS:
+            previous_handlers[signum] = signal.signal(signum, interrupted)
+    adapter = None
+    conn = None
+    try:
+        with _open_private_log(adapter_log) as log:
+            adapter_timeout = min(ADAPTER_LIMIT,
+                                 outer_deadline - clock() - WRAPPER_RESERVE)
+            if adapter_timeout <= 0:
+                raise TimeoutError('no adapter time remains after the wrapper/readback reserve')
+            argv = adapter_argv(sys.executable, ADAPTER, case, adapter_timeout)
+            adapter = _spawn_registered(argv, log, env, popen_factory)
+        print(f'runtime_path={runtime}', flush=True)
+        deadline = min(outer_deadline, started + adapter_timeout)
+        socket_path = wait_for_socket(adapter, adapter_log, scope, case, deadline, clock, sleeper)
+        left = deadline - clock()
+        if left <= 0:
+            raise TimeoutError('no scoped time remains to perform the selected control')
+        conn = connect_fn(socket_path, left)
+        if protocol_fn is None:
+            protocol_fn = control_client.run_control_protocol
+        result = protocol_fn(conn, case, deadline)
+        conn.close()
+        conn = None
+        adapter_left = deadline - clock()
+        if adapter_left <= 0:
+            raise TimeoutError('no scoped time remains for custodian receipt/readback')
+        try:
+            adapter_status = adapter.wait(timeout=adapter_left)
+        except subprocess.TimeoutExpired as exc:
+            raise TimeoutError('custodian did not finish readback by its scoped deadline') from exc
+        if receipt_path.is_symlink() or not receipt_path.is_file():
+            raise ValueError('custodian did not export its independent closure receipt')
+        receipt = json.loads(receipt_path.read_text(encoding='utf-8'))
+        runtime_present = runtime.exists() or runtime.is_symlink()
+        validate_control_artifacts(case, adapter_status, result, receipt, runtime_present)
+        with _open_private_log(control_log) as output:
+            json.dump(result, output, sort_keys=True)
+            output.write('\n')
+        print(f'control_case={case} controller_status=0 custodian_status={adapter_status} '
+              f'custody_receipt={receipt_path} controller_receipt={control_log}', flush=True)
+        return result
+    except BaseException:
+        if conn is not None:
+            try:
+                conn.close()
+            except OSError:
+                pass
+        if adapter is not None and adapter.poll() is None:
+            try:
+                _stop_exact_adapter(adapter, outer_deadline, clock)
+            except BaseException as cleanup_error:
+                print(f'custodian_cancel_unconfirmed={type(cleanup_error).__name__}: {cleanup_error}; '
+                      f'preserve runtime={runtime}', file=sys.stderr, flush=True)
+        raise
+    finally:
+        for signum, handler in previous_handlers.items():
+            signal.signal(signum, handler)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--case', choices=sorted(CASES), required=True)
+    parser.add_argument('--scope', required=True)
+    parser.add_argument('--timeout', type=float, default=OUTER_LIMIT)
+    args = parser.parse_args(argv)
+    try:
+        log_base = os.environ.get('RHAI_OVERHEAD_LOG_BASE')
+        if not log_base:
+            raise ValueError('wrapper must provide the fixed evidence log base')
+        run_control_case(args.case, args.scope, log_base, args.timeout)
+        return 0
+    except BaseException as exc:
+        print(f'finite control failed: {type(exc).__name__}: {exc}', file=sys.stderr, flush=True)
+        return 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
