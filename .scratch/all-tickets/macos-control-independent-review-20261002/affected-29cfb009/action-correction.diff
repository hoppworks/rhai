+def managed_stopped_output_witness(progress):
+    """Prove the stopped host still has payload left after one unpublished read."""
+    counts = {}
+    for stream, total in (('stdout', MANAGED_STDOUT_TOTAL),
+                          ('stderr', MANAGED_STDERR_TOTAL)):
+        value = progress.get(stream + '_bytes_read') if type(progress) is dict else None
+        if type(value) is not int or value < 0 or value > total:
+            raise ValueError('Managed stopped capture progress counter is invalid')
+        upper = value + MANAGED_READ_BUDGET
+        if upper >= total:
+            raise ValueError('Managed stopped capture does not prove unfinished capture')
+        counts[stream + '_upper_bytes'] = upper
+    counts['maximum_unpublished_read_bytes'] = MANAGED_READ_BUDGET
+    return counts
+
