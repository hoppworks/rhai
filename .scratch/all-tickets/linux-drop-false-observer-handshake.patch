+#[cfg(all(target_os = "linux", not(feature = "no_index"), not(feature = "no_float")))]
+fn drop_false_observer_barrier(case: &str, fixture_root: &std::path::Path, fields: &str) {
+    let Some(directory) = std::env::var_os(DROP_FALSE_OBSERVER_DIR_ENV).map(std::path::PathBuf::from) else {
+        return;
+    };
+    let test_pid = std::process::id();
+    let request_id = format!("{case}-{test_pid}");
+    let request = directory.join(format!("{request_id}.request"));
+    let acknowledgement = directory.join(format!("{request_id}.ack"));
+    assert!(!request.exists() && !acknowledgement.exists(), "observer request path must be fresh");
+    let host_start_ticks = managed_pipe_start_ticks(test_pid as i32);
+    let record = format!("request_id={request_id}\ncase={case}\ntest_pid={test_pid}\ntest_start_ticks={host_start_ticks}\nfixture_root={}\n{fields}", fixture_root.display());
+    managed_atomic_record(&request, &record);
+    let expected = format!("{record}observer_ack=true\n");
+    let deadline = Instant::now() + Duration::from_secs(8);
+    loop {
+        if let Ok(actual) = std::fs::read_to_string(&acknowledgement) {
+            assert_eq!(actual, expected, "observer acknowledgement must bind the exact request");
+            return;
+        }
+        assert!(Instant::now() < deadline, "independent live-process observer did not acknowledge the bounded fixture phase");
+        std::thread::sleep(Duration::from_millis(2));
+    }
+}
