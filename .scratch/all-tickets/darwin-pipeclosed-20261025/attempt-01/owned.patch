+#[cfg(all(target_os = "macos", not(feature = "no_index"), not(feature = "no_float")))]
+#[derive(Debug, Clone)]
+struct DarwinPipeMember {
+    pid: i32,
+    parent: i32,
+    group: i32,
+    start_seconds: u64,
+    start_micros: u64,
+    state: u32,
+}
+
+#[cfg(all(target_os = "macos", not(feature = "no_index"), not(feature = "no_float")))]
+impl DarwinPipeMember {
+    fn same_instance(&self, other: &Self) -> bool {
+        self.pid == other.pid
+            && self.group == other.group
+            && self.start_seconds == other.start_seconds
+            && self.start_micros == other.start_micros
+    }
+
+    fn is_live(&self) -> bool {
+        self.state != 0 && self.state != libc::SZOMB
+    }
+}
+
+#[cfg(all(target_os = "macos", not(feature = "no_index"), not(feature = "no_float")))]
+fn darwin_pipe_member(pid: i32) -> std::io::Result<Option<DarwinPipeMember>> {
+    if pid <= 0 {
+        return Err(std::io::Error::new(std::io::ErrorKind::InvalidInput, "expected a positive owned PID"));
+    }
+    let mut info = std::mem::MaybeUninit::<libc::proc_bsdinfo>::uninit();
+    let size = std::mem::size_of::<libc::proc_bsdinfo>() as i32;
+    // SAFETY: libproc receives a correctly sized, writable proc_bsdinfo buffer. Read it only
+    // after the kernel reports that the complete structure was written.
+    let received = unsafe { libc::proc_pidinfo(pid, libc::PROC_PIDTBSDINFO, 0, info.as_mut_ptr().cast(), size) };
+    if received <= 0 {
+        let error = std::io::Error::last_os_error();
+        return if error.raw_os_error() == Some(libc::ESRCH) { Ok(None) } else { Err(error) };
+    }
+    if received != size {
+        return Err(std::io::Error::new(std::io::ErrorKind::InvalidData, format!("proc_pidinfo returned {received}/{size} bytes for PID {pid}")));
+    }
+    // SAFETY: the complete structure was initialized by the successful call above.
+    let info = unsafe { info.assume_init() };
+    if info.pbi_pid != pid as u32 {
+        return Err(std::io::Error::new(std::io::ErrorKind::InvalidData, "proc_pidinfo returned a different PID"));
+    }
+    Ok(Some(DarwinPipeMember {
+        pid,
+        parent: info.pbi_ppid as i32,
+        group: info.pbi_pgid as i32,
+        start_seconds: info.pbi_start_tvsec,
+        start_micros: info.pbi_start_tvusec,
+        state: info.pbi_status,
+    }))
+}
